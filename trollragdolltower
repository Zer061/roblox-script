-- 2. دالة الفارم الأساسية (نفس منطق سكربتك الأصلي بالملي)
local function startFarmLoop()
    task.spawn(function()
        while _G.MasterTeleportFarm do
            task.wait(0.1) -- مهلة استقرار اللاعب بين الدورات
            
            local character = player.Character
            if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChildOfClass("Humanoid").Health > 0 then
                local hrp = character.HumanoidRootPart
                StatusLabel.Text = "Status: FARMING ACTIVE"
                
                ---------------------------------------------------------
                -- الجزء الأول: الانتقال وتجميع الكاش من 1 إلى 12
                ---------------------------------------------------------
                local giveReward = workspace:FindFirstChild("GiveReward")
                local cashTouchpart = giveReward and giveReward:FindFirstChild("CashTouchpart")
                
                if cashTouchpart then
                    local children = cashTouchpart:GetChildren()
                    for i = 1, 12 do
                        if not _G.MasterTeleportFarm then break end
                        
                        local item = children[i]
                        if item and item:IsA("Instance") then
                            local touchPart = item:FindFirstChild("TouchPart")
                            if touchPart and touchPart:IsA("BasePart") then
                                hrp.Velocity = Vector3.new(0, 0, 0)
                                hrp.CFrame = touchPart.CFrame
                                task.wait(0.05)
                            end
                        end
                    end
                end
                
                ---------------------------------------------------------
                -- الجزء الثاني: الانتقال إلى جزء الفوز وإنهاء البرج (Win Room)
                ---------------------------------------------------------
                if not _G.MasterTeleportFarm then break end
                
                local tower = workspace:FindFirstChild("Tower")
                local endFolder = tower and tower:FindFirstChild("End")
                local winRoom = endFolder and endFolder:FindFirstChild("Win Room")
                local finish = winRoom and winRoom:FindFirstChild("Finish")
                local winPart = finish and finish:FindFirstChild("TouchPart")
                
                if winPart and winPart:IsA("BasePart") then
                    hrp.Velocity = Vector3.new(0, 0, 0)
                    hrp.CFrame = winPart.CFrame
                    task.wait(0.01)
                end
                
            else
                StatusLabel.Text = "Status: Waiting for Respawn..."
                task.wait(0.1)
            end
        end
    end)
end

-- 3. ربط الزر بالتشغيل التلقائي وتغيير الألوان بشكل تفاعلي
ToggleBtn.MouseButton1Click:Connect(function()
