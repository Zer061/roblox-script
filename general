local function toggleButton(parent, order, labelText)
	local btn = Instance.new("TextButton")
	btn.Name = string.gsub(labelText, "%s", "") .. "Toggle"
	btn.LayoutOrder = order
	btn.Size = UDim2.new(1, 0, 0, SIZE.rowH)
