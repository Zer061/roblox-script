local function removeEsp(plr)
	local o = espObjects[plr]
	if not o then
		return
	end
	if o.highlight then
		o.highlight:Destroy()
	end
	if o.billboard then
		o.billboard:Destroy()
	end
	espObjects[plr] = nil
end

local function clearEsp()
	for plr in pairs(espObjects) do
		removeEsp(plr)
	end
end

