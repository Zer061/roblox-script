local function setAutoMove(on)
	state.AutoMove = on
	paintToggle(autoMoveBtn, "Auto Move", on)

	autoMoveGen = autoMoveGen + 1
	if not on then
		return
	end

	-- Auto Move has nothing to aim at without the scanner running.
	if not state.KeyESP then
		setKeyESP(true)
	end
	table.clear(visited)

	local generation = autoMoveGen
	task.spawn(function()
		while state.AutoMove and generation == autoMoveGen do
			local target = nextTarget()
			if target then
				local o = keyObjects[target]
				if o and o.part and o.part.Parent then
					-- Save position before moving
					local savedCF
					if state.MoveReturn then
						local char = player.Character
						local root = char and char:FindFirstChild("HumanoidRootPart")
						if root then
							savedCF = root.CFrame
						end
					end

					if state.MoveWalk then
						-- Walk mode: pathfind around walls
						walkTo(o.part.Position, function()
							return state.AutoMove and generation == autoMoveGen
						end)
					else
						-- Teleport mode: instant
						teleportTo(o.part.Position)
					end
					task.wait(1)
					-- Interact with the target
					firePromptsOn(o.part)
					-- Wait MoveDelay for game to register
					task.wait(math.max(state.MoveDelay, 0.5))

					-- Return to original position after interaction
					if state.MoveReturn and savedCF then
						if state.MoveWalk then
							walkTo(
								Vector3.new(savedCF.X, savedCF.Y, savedCF.Z),
								function()
									return state.AutoMove and generation == autoMoveGen
								end
							)
						else
							local char = player.Character
							local root = char and char:FindFirstChild("HumanoidRootPart")
							if root then
								root.CFrame = savedCF
							end
						end
					end
				end
				visited[target] = true
			else
				table.clear(visited) -- start the round again
			end
			task.wait(math.max(state.MoveDelay, 0.1))
		end
	end)
end

