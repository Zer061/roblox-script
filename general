end)

-- What to look for: any object whose name contains this text.
local queryBox = textRow(keyPage, 2, "Name has", keyQuery, DEFAULTS.KeyQuery, function(text)
	text = string.match(string.lower(text or ""), "^%s*(.-)%s*$")
	if text == "" then
		text = DEFAULTS.KeyQuery
	end
	keyQuery = text
	clearKeyEsp()
	if state.KeyESP then
		scanForKeys()
		refreshKeyTags()
	end
	return text
end)

