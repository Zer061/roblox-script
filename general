--------------------------------------------------------------------
-- KEY TAB: TRAVEL TO WHAT WAS FOUND
--   Auto Move walks the list nearest-first, one hop per Move Delay.
--   Objects already visited are skipped until nothing is left, then the
--   list is reused, so a key that respawns is picked up again.
--------------------------------------------------------------------

local visited = {} -- Instance -> true, cleared when the list runs out
local autoMoveGen = 0 -- guards against two loops running after a fast re-toggle

local function teleportTo(position)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local landing = position + Vector3.new(0, 3, 0)
	-- keep facing roughly where the camera was pointing
	root.CFrame = CFrame.new(landing, landing + root.CFrame.LookVector)
	return true
end

-- Walk to a position using PathfindingService (finds path around walls).
-- `checkFn` is called between waypoints; if it returns false the walk stops.
-- Returns true if arrived, false if cancelled or path failed.
local PathfindingService = game:GetService("PathfindingService")

local function walkTo(position, checkFn)
	local char = player.Character
	local hum = char and char:FindFirstChildWhichIsA("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then
		return false
	end

	-- Try multiple AgentRadius: smaller radius can fit through narrow doors
	local pathConfigs = {
		{ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4 },
		{ AgentRadius = 1, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 3 },
		{ AgentRadius = 0.5, AgentHeight = 4, AgentCanJump = true, WaypointSpacing = 2 },
	}

	local waypoints = nil
	for _, cfg in ipairs(pathConfigs) do
		local path = PathfindingService:CreatePath(cfg)
		local ok = pcall(function()
			path:ComputeAsync(root.Position, position)
		end)
		if ok and path.Status == Enum.PathStatus.Success then
			waypoints = path:GetWaypoints()
			break
		end
	end

	if not waypoints then
		-- All configs failed → skip target
		return false
	end

	local maxRetries = 2
	local attempt = 0

	while attempt <= maxRetries do
		for i, wp in ipairs(waypoints) do
			if checkFn and not checkFn() then
				return false
			end
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
			hum:MoveTo(wp.Position)
			-- Wait for arrival with stuck detection
			local reached = false
			local conn
			conn = hum.MoveToFinished:Connect(function(didReach)
				reached = true
				if conn then conn:Disconnect() end
			end)
			local startT = tick()
			local lastPos = root.Position
			local stuckTime = 0
			while not reached and (tick() - startT) < 6 do
				task.wait(0.15)
				if checkFn and not checkFn() then
					if conn then conn:Disconnect() end
					return false
				end
				local moved = (root.Position - lastPos).Magnitude
				if moved < 0.5 then
					stuckTime = stuckTime + 0.15
					if stuckTime >= 1.5 then
						-- Stuck → try recompute from current position
						if conn then conn:Disconnect() end
						reached = nil -- signal stuck
						break
					end
				else
					stuckTime = 0
					lastPos = root.Position
				end
			end
			if reached == nil then
				-- Stuck: recompute path from current position
				attempt = attempt + 1
				if attempt > maxRetries then
					return false
				end
				local newWaypoints = nil
				for _, cfg in ipairs(pathConfigs) do
					local p2 = PathfindingService:CreatePath(cfg)
					local ok2 = pcall(function()
						p2:ComputeAsync(root.Position, position)
					end)
					if ok2 and p2.Status == Enum.PathStatus.Success then
						newWaypoints = p2:GetWaypoints()
						break
					end
				end
				if not newWaypoints then
					return false
				end
				waypoints = newWaypoints
				break -- restart waypoint loop with new path
			end
			if not reached then
				if conn then conn:Disconnect() end
			end
		end
		-- Check if we arrived close enough
		if root.Parent and (root.Position - position).Magnitude < 6 then
			return true
		end
		attempt = attempt + 1
	end
	return (root.Parent and (root.Position - position).Magnitude < 10)
end

local function nextTarget()
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not myRoot then
		return nil
	end

	local best, bestDist = nil, math.huge
	for inst, o in pairs(keyObjects) do
		if not visited[inst] and o.part and o.part.Parent then
			local dist = (o.part.Position - myRoot.Position).Magnitude
			if dist < bestDist then
				best, bestDist = inst, dist
			end
		end
	end
	return best
end

