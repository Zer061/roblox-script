UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	local code = input.KeyCode
	if code == Enum.KeyCode.RightShift then
		panel.Visible = not panel.Visible
	elseif code == Enum.KeyCode.N then
		setNoclip(not state.Noclip)
	elseif code == Enum.KeyCode.B then
		setFullbright(not state.Fullbright)
	elseif code == Enum.KeyCode.V then
		setESP(not state.ESP)
	elseif code == Enum.KeyCode.K then
		setKeyESP(not state.KeyESP)
	elseif code == Enum.KeyCode.LeftBracket then
		setFOV(state.FOV - 5)
	elseif code == Enum.KeyCode.RightBracket then
		setFOV(state.FOV + 5)
	end
end)

--------------------------------------------------------------------
-- SHOW / HIDE + DRAGGING (mouse and touch)
--------------------------------------------------------------------

toggleBtn.Activated:Connect(function()
	panel.Visible = not panel.Visible
end)

do
	local dragging, dragStart, startPos = false, nil, nil

	local function beginDrag(input)
		dragging = true
		dragStart = input.Position
		startPos = panel.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end

	title.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			beginDrag(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local delta = input.Position - dragStart
			panel.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

