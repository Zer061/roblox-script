--[[
	Player Tweaks Panel
	-------------------
	A LocalScript that shows a small draggable GUI for adjusting
	WalkSpeed, Jump (Power or Height), and toggling Noclip.

	WHERE TO PUT IT:
		StarterPlayer > StarterPlayerScripts   (recommended)
		or StarterGui (as a LocalScript inside a ScreenGui)

	Works on PC and mobile (touch drag + big tap targets).
	Settings are re-applied automatically after respawn.
--]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

--------------------------------------------------------------------
-- STATE
--------------------------------------------------------------------

local DEFAULTS = {
	WalkSpeed = 16,
	JumpPower = 50,
	JumpHeight = 7.2,
}

local state = {
	WalkSpeed = DEFAULTS.WalkSpeed,
	JumpPower = DEFAULTS.JumpPower,
	JumpHeight = DEFAULTS.JumpHeight,
	Noclip = false,
}

local rows = {} -- key -> { textBox = TextBox, ... } for refreshing displayed values
local originalCollide = {} -- BasePart -> original CanCollide, used to restore after noclip

--------------------------------------------------------------------
-- CHARACTER HELPERS
--------------------------------------------------------------------

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function applyStats()
	local hum = getHumanoid()
	if not hum then
		return
	end

	hum.WalkSpeed = state.WalkSpeed

	-- Roblox has two jump systems; respect whichever the game uses.
	if hum.UseJumpPower then
		hum.JumpPower = state.JumpPower
	else
		hum.JumpHeight = state.JumpHeight
	end
end

local function snapshotCollisions()
	table.clear(originalCollide)
	local char = player.Character
	if not char then
		return
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			originalCollide[part] = part.CanCollide
		end
	end
end

local function restoreCollisions()
	for part, canCollide in pairs(originalCollide) do
		if part.Parent then
			part.CanCollide = canCollide
		end
	end
	table.clear(originalCollide)
end

-- Noclip loop: keeps every character part non-colliding while enabled.
RunService.Stepped:Connect(function()
	if not state.Noclip then
		return
	end
	local char = player.Character
	if not char then
		return
	end
	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") and part.CanCollide then
			if originalCollide[part] == nil then
				originalCollide[part] = true
			end
			part.CanCollide = false
		end
	end
end)

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid")
	task.wait(0.25)
	applyStats()
	if state.Noclip then
		snapshotCollisions()
	end
end)

--------------------------------------------------------------------
-- UI THEME
--------------------------------------------------------------------

local THEME = {
	bg = Color3.fromRGB(24, 26, 33),
	panel = Color3.fromRGB(33, 36, 45),
	stroke = Color3.fromRGB(58, 63, 77),
	text = Color3.fromRGB(235, 238, 245),
	muted = Color3.fromRGB(150, 157, 172),
	accent = Color3.fromRGB(88, 140, 255),
	on = Color3.fromRGB(56, 176, 108),
	off = Color3.fromRGB(70, 74, 88),
}

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color or THEME.stroke
	s.Thickness = thickness or 1
	s.Parent = parent
	return s
end

--------------------------------------------------------------------
-- BUILD GUI
--------------------------------------------------------------------

local gui = Instance.new("ScreenGui")
gui.Name = "PlayerTweaks"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

-- Small floating button that shows/hides the panel
local toggleBtn = Instance.new("TextButton")
toggleBtn.Name = "ToggleButton"
toggleBtn.Size = UDim2.fromOffset(52, 52)
toggleBtn.Position = UDim2.new(0, 16, 0, 90)
toggleBtn.BackgroundColor3 = THEME.accent
toggleBtn.Text = "\u{2699}"
toggleBtn.TextSize = 26
toggleBtn.TextColor3 = Color3.new(1, 1, 1)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.AutoButtonColor = true
toggleBtn.Parent = gui
corner(toggleBtn, 26)

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.Size = UDim2.fromOffset(280, 300)
panel.Position = UDim2.new(0, 80, 0, 90)
panel.BackgroundColor3 = THEME.bg
panel.BorderSizePixel = 0
panel.Active = true
panel.Visible = false
panel.Parent = gui
corner(panel, 12)
stroke(panel)

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = panel

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 10)
padding.PaddingBottom = UDim.new(0, 10)
padding.PaddingLeft = UDim.new(0, 10)
padding.PaddingRight = UDim.new(0, 10)
padding.Parent = panel

-- Title bar (also the drag handle)
local title = Instance.new("TextLabel")
title.Name = "Title"
title.LayoutOrder = 0
title.Size = UDim2.new(1, 0, 0, 26)
title.BackgroundTransparency = 1
title.Text = "Player Tweaks"
title.TextColor3 = THEME.text
title.TextSize = 17
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = panel

--------------------------------------------------------------------
-- ROW BUILDER: label + [-] [value] [+]
--------------------------------------------------------------------

local function clamp(value, min, max)
	return math.clamp(value, min, max)
end

local function createRow(order, labelText, key, min, max, step, decimals)
	local row = Instance.new("Frame")
	row.Name = key .. "Row"
	row.LayoutOrder = order
	row.Size = UDim2.new(1, 0, 0, 56)
	row.BackgroundColor3 = THEME.panel
	row.BorderSizePixel = 0
	row.Parent = panel
	corner(row, 10)

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, -16, 0, 18)
	label.Position = UDim2.fromOffset(10, 5)
	label.BackgroundTransparency = 1
	label.Text = labelText
	label.TextColor3 = THEME.muted
	label.TextSize = 13
	label.Font = Enum.Font.Gotham
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local minus = Instance.new("TextButton")
	minus.Size = UDim2.fromOffset(30, 28)
	minus.Position = UDim2.fromOffset(10, 23)
	minus.BackgroundColor3 = THEME.off
	minus.Text = "-"
	minus.TextColor3 = THEME.text
	minus.TextSize = 20
	minus.Font = Enum.Font.GothamBold
	minus.Parent = row
	corner(minus, 8)

	local plus = Instance.new("TextButton")
	plus.Size = UDim2.fromOffset(30, 28)
	plus.Position = UDim2.new(1, -40, 0, 23)
	plus.BackgroundColor3 = THEME.off
	plus.Text = "+"
	plus.TextColor3 = THEME.text
	plus.TextSize = 20
	plus.Font = Enum.Font.GothamBold
	plus.Parent = row

	corner(plus, 8)

	local box = Instance.new("TextBox")
	box.Size = UDim2.new(1, -100, 0, 28)
	box.Position = UDim2.fromOffset(46, 23)
	box.BackgroundColor3 = THEME.bg
	box.Text = ""
	box.TextColor3 = THEME.text
	box.TextSize = 15
	box.Font = Enum.Font.GothamMedium
	box.ClearTextOnFocus = false
	box.Parent = row
	corner(box, 8)

	local function refresh()
		box.Text = string.format("%." .. tostring(decimals) .. "f", state[key])
	end

	local function setValue(v)
		state[key] = clamp(v, min, max)
		refresh()
		applyStats()
	end

	minus.Activated:Connect(function()
		setValue(state[key] - step)
	end)
	plus.Activated:Connect(function()
		setValue(state[key] + step)
	end)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			setValue(n)
		else
			refresh()
		end
	end)

	refresh()
	rows[key] = refresh
	return row
end

createRow(1, "Walk Speed", "WalkSpeed", 0, 500, 2, 0)

-- Show the jump control that matches this game's jump system.
local hum = getHumanoid()
local usesJumpPower = (hum == nil) or hum.UseJumpPower
if usesJumpPower then
	createRow(2, "Jump Power", "JumpPower", 0, 500, 5, 0)
else
	createRow(2, "Jump Height", "JumpHeight", 0, 100, 1, 1)
end

--------------------------------------------------------------------
-- NOCLIP TOGGLE
--------------------------------------------------------------------

local noclipBtn = Instance.new("TextButton")
noclipBtn.Name = "NoclipToggle"
noclipBtn.LayoutOrder = 3
noclipBtn.Size = UDim2.new(1, 0, 0, 42)
noclipBtn.BackgroundColor3 = THEME.off
noclipBtn.Text = "Noclip: OFF"
noclipBtn.TextColor3 = THEME.text
noclipBtn.TextSize = 15
noclipBtn.Font = Enum.Font.GothamBold
noclipBtn.Parent = panel
corner(noclipBtn, 10)

local function setNoclip(on)
	state.Noclip = on
	noclipBtn.Text = on and "Noclip: ON" or "Noclip: OFF"
	noclipBtn.BackgroundColor3 = on and THEME.on or THEME.off
	if on then
		snapshotCollisions()
	else
		restoreCollisions()
	end
end

noclipBtn.Activated:Connect(function()
	setNoclip(not state.Noclip)
end)

--------------------------------------------------------------------
-- RESET
--------------------------------------------------------------------

local resetBtn = Instance.new("TextButton")
resetBtn.Name = "Reset"
resetBtn.LayoutOrder = 4
resetBtn.Size = UDim2.new(1, 0, 0, 36)
resetBtn.BackgroundColor3 = THEME.panel
resetBtn.Text = "Reset to default"
resetBtn.TextColor3 = THEME.muted
resetBtn.TextSize = 14
resetBtn.Font = Enum.Font.Gotham
resetBtn.Parent = panel
corner(resetBtn, 10)

resetBtn.Activated:Connect(function()
	state.WalkSpeed = DEFAULTS.WalkSpeed
	state.JumpPower = DEFAULTS.JumpPower
	state.JumpHeight = DEFAULTS.JumpHeight
	for _, refresh in pairs(rows) do
		refresh()
	end
	setNoclip(false)
	applyStats()
end)

--------------------------------------------------------------------
-- SHOW / HIDE + DRAGGING (mouse and touch)
--------------------------------------------------------------------

toggleBtn.Activated:Connect(function()
	panel.Visible = not panel.Visible
end)

-- Optional keyboard shortcut on PC
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.RightShift then
		panel.Visible = not panel.Visible
	end
end)

do
	local dragging, dragStart, startPos = false, nil, nil

	local function beginDrag(input)
		dragging = true
		dragStart = input.Position
		startPos = panel.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end

	title.InputBegan:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			beginDrag(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if
			input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		then
			local delta = input.Position - dragStart
			panel.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

applyStats()
