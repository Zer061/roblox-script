-- ===== RETREAT (rút lui hồi máu) =====

local retreatPercent = 30 -- máu dưới mức này thì bay lên trời
local retreatAltitude = 1000 -- bay cao thêm bấy nhiêu studs
local retreating = false
local retreatAnchor = nil -- điểm treo trên trời khi đang chờ hồi máu

local function setRetreatPercent(value)
	retreatPercent = math.clamp(math.floor(value + 0.5), 0, 100)

	local alpha = retreatPercent / 100
	hpLabel.Text = "Retreat HP: " .. retreatPercent .. "%"
	sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
	sliderKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
end

do
	local dragging = false

	local function updateFromInput(input)
		local origin = sliderBar.AbsolutePosition.X
		local width = math.max(sliderBar.AbsoluteSize.X, 1)

		setRetreatPercent(math.clamp((input.Position.X - origin) / width, 0, 1) * 100)
	end

	sliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local enabled = false

local function isNoobFolder(instance)
	if not instance:IsA("Folder") then
		return false
	end

	local name = instance.Name:lower()

	return name == "allnoobs" or name:find("noob", 1, true) ~= nil
end

local function killNoobs()
	for _, object in ipairs(Workspace:GetDescendants()) do
		if isNoobFolder(object) then
			for _, descendant in ipairs(object:GetDescendants()) do
				if descendant:IsA("Humanoid") then
					descendant.Health = 0
				end
			end
		end
	end
end

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
		killNoobs()
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
	end
end)

task.spawn(function()
