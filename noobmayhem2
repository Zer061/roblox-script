end)

-- ===== FLY =====

local flying = false
local flySpeed = 60
local holdingUp = false
local holdingDown = false
local aimTarget = nil -- được Auto Attack / Auto Farm set, dùng chung với BodyGyro khi đang bay
local autoFarm = false
local farmDestination = nil -- Vector3 điểm bay tới khi đang farm
local farmAwayDir = nil -- hướng đứng so với mục tiêu, tính lại mỗi tick farm
local farmHoverDistance = 2 -- sai số cho phép quanh điểm đứng
local keepDistance = 18 -- khoảng cách ngang luôn giữ với mục tiêu
local hoverHeight = 14 -- bay cao hơn mục tiêu bấy nhiêu studs

-- Chế độ gây damage: HP=0 (nhanh, KHONG duoc coin) hoặc vũ khí (chậm hơn, có coin)
local useWeapon = false
local standoffDistance = keepDistance -- khoảng cách đang thực sự dùng
local standoffHeight = hoverHeight

-- Khoảng cách đứng do slider Keep quyết định ở cả 2 chế độ:
-- súng thì để xa cho an toàn, cận chiến thì kéo Keep xuống ~5 cho chạm được.
local function refreshStandoff()
	standoffDistance = keepDistance
	standoffHeight = hoverHeight
end

local bodyVelocity, bodyGyro, flyConnection

local function getCharacterParts()
	local character = player.Character

	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return root, humanoid
end

local function getFlyDirection(root, humanoid)
	local camera = Workspace.CurrentCamera
	local direction = Vector3.zero

	-- Rút lui hồi máu: ưu tiên cao nhất, kể cả khi đang farm
	if retreating and retreatAnchor then
		local offset = retreatAnchor - root.Position

		if offset.Magnitude <= 4 then
			return Vector3.zero
		end

		return offset.Unit * math.clamp(offset.Magnitude / 12, 0.15, 1)
	end

	-- Auto Farm lái thay người chơi
	if autoFarm and farmDestination then
		local destination = farmDestination

		-- bám mục tiêu theo từng frame, không đợi tick farm 0.4s
		if farmAwayDir and aimTarget and aimTarget.Parent then
			destination = aimTarget.Position + farmAwayDir * standoffDistance + Vector3.new(0, standoffHeight, 0)
		end

		local offset = destination - root.Position
		local distance = offset.Magnitude

		if distance <= farmHoverDistance then
			return Vector3.zero
		end

		-- giảm tốc khi tới gần điểm đứng để không vọt qua rồi dao động
		return offset.Unit * math.clamp(distance / 12, 0.08, 1)
	end

	if camera then
		local cf = camera.CFrame

		if UserInputService.KeyboardEnabled and not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction += cf.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction -= cf.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction -= cf.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction += cf.RightVector
			end
		end
	end

	-- Mobile joystick / gamepad fallback
	if direction.Magnitude == 0 then
		direction = humanoid.MoveDirection
	end

	if holdingUp or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.new(0, 1, 0)
	end
	if holdingDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction -= Vector3.new(0, 1, 0)
	end

	if direction.Magnitude > 0 then
		return direction.Unit
	end

	return Vector3.zero
end

local function stopFly()
	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	local _, humanoid = getCharacterParts()

	if humanoid then
		humanoid.PlatformStand = false
	end

	flyToggle.Text = "FLY: OFF"
	flyToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
end

local function startFly()
	local root, humanoid = getCharacterParts()

	if not root then
		return
	end

	flying = true

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "FlyVelocity"
	bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 9e9
	bodyVelocity.P = 9e4
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "FlyGyro"
	bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 9e9
	bodyGyro.P = 9e4
	bodyGyro.D = 500
	bodyGyro.CFrame = root.CFrame
	bodyGyro.Parent = root

	flyToggle.Text = "FLY: ON"
	flyToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)

	flyConnection = RunService.RenderStepped:Connect(function()
		local currentRoot, currentHumanoid = getCharacterParts()

		if not currentRoot or currentRoot ~= root then
			stopFly()
			return
		end

		-- Không rơi khi đứng yên
		currentHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)

		bodyVelocity.Velocity = getFlyDirection(currentRoot, currentHumanoid) * flySpeed

		local look

		if aimTarget and aimTarget.Parent then
			look = (aimTarget.Position - currentRoot.Position) * Vector3.new(1, 0, 1)
		else
			local camera = Workspace.CurrentCamera
			look = camera and camera.CFrame.LookVector * Vector3.new(1, 0, 1) or nil
		end

		if look and look.Magnitude > 0.01 then
			bodyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + look.Unit)
		end
	end)
end

local function toggleFly()
	if flying then
		stopFly()
	else
		startFly()
	end
end

