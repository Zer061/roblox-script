			local ok, err = pcall(attackStep)

			if not ok then
				warn("[AutoAttack]", err)
			end
		end

		task.wait(attackCooldown)
	end
end)

-- ===== AUTO FARM =====

local farmScanRange = 5000 -- quét toàn map (bị giới hạn bởi streaming nếu game bật)
local clusterRadius = 40 -- bán kính tính "cụm"
local farmStuckTimeout = 10 -- bám 1 mục tiêu quá lâu thì bỏ qua
local farmTargetModel = nil
local farmTargetSince = 0

-- Chọn mục tiêu thuộc cụm đông nhất, có trừ điểm theo khoảng cách
local function pickCluster(root)
	local targets = collectTargets(root, farmScanRange)

	if #targets == 0 then
		return nil
	end

	local best, bestScore

	for _, candidate in ipairs(targets) do
		local count = 0

		for _, other in ipairs(targets) do
			if (other.root.Position - candidate.root.Position).Magnitude <= clusterRadius then
				count += 1
			end
		end

		local score = count * 3 - candidate.distance / 25

		if not bestScore or score > bestScore then
			best, bestScore = candidate, score
		end
	end

	return best
end

-- Hướng đứng so với mục tiêu: giữ phía hiện tại, cộng lực đẩy khỏi đám đang áp sát
local function computeAwayDirection(root, targetRoot)
	local myPos = root.Position
	local targetPos = targetRoot.Position

	-- giữ nguyên phía mình đang đứng so với mục tiêu, khỏi bay vòng vô nghĩa
	local away = (myPos - targetPos) * Vector3.new(1, 0, 1)

	away = away.Magnitude > 0.5 and away.Unit or Vector3.new(1, 0, 0)

	-- lực đẩy khỏi mọi noob đang lọt vào vùng an toàn
	local push = Vector3.zero

	for _, other in ipairs(collectTargets(root, keepDistance * 2)) do
		local offset = (myPos - other.root.Position) * Vector3.new(1, 0, 1)
		local distance = offset.Magnitude

		if distance > 0.5 and distance < keepDistance then
			push += offset.Unit * ((keepDistance - distance) / keepDistance)
		end
	end

	if push.Magnitude > 0 then
		local blended = away + push * 1.5

		if blended.Magnitude > 0.1 then
			away = blended.Unit
		end
	end

	return away
end

local function farmStep()
	local root, humanoid = getCharacterParts()

	if not root then
		farmDestination = nil
		return
	end

	if not flying then
		startFly()
	end

	-- mục tiêu hiện tại còn dùng được không?
	local keepTarget = false

	if farmTargetModel and farmTargetModel.Parent and not blacklist[farmTargetModel] then
		local targetHumanoid = farmTargetModel:FindFirstChildOfClass("Humanoid")
		keepTarget = targetHumanoid ~= nil and targetHumanoid.Health > 0
	end

	-- bám mãi không hạ được (bất tử / không tới nơi) thì bỏ, cấm 20s
	if keepTarget and os.clock() - farmTargetSince > farmStuckTimeout then
		blacklist[farmTargetModel] = os.clock() + 20
		keepTarget = false
	end

	if not keepTarget then
		local pick = pickCluster(root)

		if not pick then
			farmTargetModel, farmDestination, farmAwayDir, aimTarget = nil, nil, nil, nil
			statusLabel.Text = "Farm: khong thay muc tieu"
			return
		end

		farmTargetModel = pick.model
		farmTargetSince = os.clock()
	end

	local targetRoot = farmTargetModel:FindFirstChild("HumanoidRootPart") or farmTargetModel.PrimaryPart

	if not targetRoot then
		farmTargetModel = nil
		return
	end

	farmAwayDir = computeAwayDirection(root, targetRoot)
	farmDestination = targetRoot.Position + farmAwayDir * keepDistance + Vector3.new(0, hoverHeight, 0)
	aimTarget = targetRoot

	local distance = (targetRoot.Position - root.Position).Magnitude
	statusLabel.Text = string.format("Farm: %s (%.0f)", farmTargetModel.Name, distance)

	-- đủ gần để có network ownership thì kill mới ăn, không cần áp sát
	killNoobs()

	if distance <= attackRange then
		local tool = getEquippedTool(player.Character, humanoid)

		if tool then
			tool:Activate()
		end
	end
end

local function setAutoFarm(state)
	autoFarm = state

	if autoFarm then
		farmToggle.Text = "AUTO FARM: ON"
		farmToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
	else
		farmToggle.Text = "AUTO FARM: OFF"
		farmToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
		farmTargetModel = nil
		farmDestination = nil
		farmAwayDir = nil
		aimTarget = nil
		statusLabel.Text = "Target: none"
	end
end

farmToggle.MouseButton1Click:Connect(function()
