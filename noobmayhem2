-- ===== VÒNG LẶP THEO DÕI MÁU =====

local function retreatStep()
	local root, humanoid = getCharacterParts()

	if not root then
		retreating = false
		retreatAnchor = nil
		return
	end

	if humanoid.MaxHealth <= 0 then
		return
	end

	local ratio = humanoid.Health / humanoid.MaxHealth * 100

	if not retreating then
		if ratio <= retreatPercent then
			retreating = true
			retreatAnchor = root.Position + Vector3.new(0, retreatAltitude, 0)
			aimTarget = nil

			if not flying then
				startFly()
			end
		end

		return
	end

	-- hồi đủ thì quay lại làm việc
	local resumeAt = math.min(95, retreatPercent + 40)

	statusLabel.Text = string.format("Hoi mau: %.0f%% / %d%%", ratio, resumeAt)

	if ratio >= resumeAt then
		retreating = false
		retreatAnchor = nil
	end
end

task.spawn(function()
	while gui.Parent do
		local ok, err = pcall(retreatStep)

		if not ok then
			warn("[Retreat]", err)
		end

		task.wait(0.25)
	end
end)

-- ===== FULLBRIGHT =====

local fullbright = false
local lightingBackup = nil
local atmosphereBackup = {}

local function applyFullbright()
	Lighting.Ambient = Color3.fromRGB(178, 178, 178)
	Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.FogEnd = 1e6
	Lighting.FogStart = 1e6
	Lighting.GlobalShadows = false
	Lighting.ExposureCompensation = 0

	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("Atmosphere") then
			if not atmosphereBackup[object] then
				atmosphereBackup[object] = {
					Density = object.Density,
					Haze = object.Haze,
				}
			end

			object.Density = 0
			object.Haze = 0
		end
	end
end

local function setFullbright(state)
	fullbright = state

	if fullbright then
		-- lưu lại thiết lập gốc đúng 1 lần để còn trả về
		lightingBackup = lightingBackup or {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogEnd = Lighting.FogEnd,
			FogStart = Lighting.FogStart,
			GlobalShadows = Lighting.GlobalShadows,
			ExposureCompensation = Lighting.ExposureCompensation,
		}

		applyFullbright()

		brightToggle.Text = "FULLBRIGHT: ON"
		brightToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
	else
		if lightingBackup then
			for property, value in pairs(lightingBackup) do
				Lighting[property] = value
			end
		end

		for object, values in pairs(atmosphereBackup) do
			if object.Parent then
				object.Density = values.Density
				object.Haze = values.Haze
			end
		end

		atmosphereBackup = {}

		brightToggle.Text = "FULLBRIGHT: OFF"
		brightToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
	end
end

