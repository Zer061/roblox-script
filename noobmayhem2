local enabled = false

local function isNoobFolder(instance)
	if not instance:IsA("Folder") then
		return false
	end

	local name = instance.Name:lower()

	return name == "allnoobs" or name:find("noob", 1, true) ~= nil
end

local function killNoobs()
	for _, object in ipairs(Workspace:GetDescendants()) do
		if isNoobFolder(object) then
			for _, descendant in ipairs(object:GetDescendants()) do
				if descendant:IsA("Humanoid") then
					descendant.Health = 0
				end
			end
		end
	end
end

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then
		toggle.Text = "ON"
		toggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
		killNoobs()
	else
		toggle.Text = "OFF"
		toggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
	end
end)

task.spawn(function()
	while gui.Parent do
		if enabled then
			killNoobs()
		end

		task.wait(0.15)
	end
end)

-- ===== FLY =====

local flying = false
local flySpeed = 60
local holdingUp = false
local holdingDown = false

local bodyVelocity, bodyGyro, flyConnection

local function getCharacterParts()
	local character = player.Character

	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return root, humanoid
end

local function getFlyDirection(humanoid)
	local camera = Workspace.CurrentCamera
	local direction = Vector3.zero

	if camera then
		local cf = camera.CFrame

		if UserInputService.KeyboardEnabled and not UserInputService:GetFocusedTextBox() then
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				direction += cf.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				direction -= cf.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				direction -= cf.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				direction += cf.RightVector
			end
		end
	end

	-- Mobile joystick / gamepad fallback
	if direction.Magnitude == 0 then
		direction = humanoid.MoveDirection
	end

	if holdingUp or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
		direction += Vector3.new(0, 1, 0)
	end
	if holdingDown or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
		direction -= Vector3.new(0, 1, 0)
	end

	if direction.Magnitude > 0 then
		return direction.Unit
	end

	return Vector3.zero
end

local function stopFly()
	flying = false

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end

	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end

	local _, humanoid = getCharacterParts()

	if humanoid then
		humanoid.PlatformStand = false
	end

	flyToggle.Text = "FLY: OFF"
	flyToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
end

local function startFly()
	local root, humanoid = getCharacterParts()

	if not root then
		return
	end

	flying = true

	bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Name = "FlyVelocity"
	bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 9e9
	bodyVelocity.P = 9e4
	bodyVelocity.Velocity = Vector3.zero
	bodyVelocity.Parent = root

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.Name = "FlyGyro"
	bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 9e9
	bodyGyro.P = 9e4
	bodyGyro.D = 500
	bodyGyro.CFrame = root.CFrame
	bodyGyro.Parent = root

	flyToggle.Text = "FLY: ON"
	flyToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)

	flyConnection = RunService.RenderStepped:Connect(function()
		local currentRoot, currentHumanoid = getCharacterParts()

		if not currentRoot or currentRoot ~= root then
			stopFly()
			return
		end

		-- Không rơi khi đứng yên
		currentHumanoid:ChangeState(Enum.HumanoidStateType.Freefall)

		bodyVelocity.Velocity = getFlyDirection(currentHumanoid) * flySpeed

		local camera = Workspace.CurrentCamera

		if camera then
			local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)

			if look.Magnitude > 0 then
				bodyGyro.CFrame = CFrame.lookAt(currentRoot.Position, currentRoot.Position + look.Unit)
			end
		end
	end)
end

local function toggleFly()
	if flying then
		stopFly()
	else
		startFly()
	end
end

flyToggle.MouseButton1Click:Connect(toggleFly)

local function bindHold(button, setter)
	button.MouseButton1Down:Connect(function()
		setter(true)
	end)
	button.MouseButton1Up:Connect(function()
		setter(false)
	end)
	button.MouseLeave:Connect(function()
		setter(false)
	end)
end

bindHold(upButton, function(state)
	holdingUp = state
end)

bindHold(downButton, function(state)
	holdingDown = state
end)

local function setSpeed(value)
	flySpeed = math.clamp(value, 10, 500)
	speedLabel.Text = "Speed: " .. flySpeed
end

speedUp.MouseButton1Click:Connect(function()
	setSpeed(flySpeed + 10)
end)

speedDown.MouseButton1Click:Connect(function()
	setSpeed(flySpeed - 10)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	end
end)

player.CharacterAdded:Connect(function()
	if flying then
		stopFly()
	end
end)

gui.Destroying:Connect(stopFly)
