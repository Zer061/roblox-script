			end
		end

		task.wait(0.4)
	end
end)

-- ===== FULLBRIGHT =====

local fullbright = false
local lightingBackup = nil
local atmosphereBackup = {}

local function applyFullbright()
	Lighting.Ambient = Color3.fromRGB(178, 178, 178)
	Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
	Lighting.Brightness = 2
	Lighting.ClockTime = 14
	Lighting.FogEnd = 1e6
	Lighting.FogStart = 1e6
	Lighting.GlobalShadows = false
	Lighting.ExposureCompensation = 0

	for _, object in ipairs(Lighting:GetChildren()) do
		if object:IsA("Atmosphere") then
			if not atmosphereBackup[object] then
				atmosphereBackup[object] = {
					Density = object.Density,
					Haze = object.Haze,
				}
			end

			object.Density = 0
			object.Haze = 0
		end
	end
end

local function setFullbright(state)
	fullbright = state

	if fullbright then
		-- lưu lại thiết lập gốc đúng 1 lần để còn trả về
		lightingBackup = lightingBackup or {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			Brightness = Lighting.Brightness,
			ClockTime = Lighting.ClockTime,
			FogEnd = Lighting.FogEnd,
			FogStart = Lighting.FogStart,
			GlobalShadows = Lighting.GlobalShadows,
			ExposureCompensation = Lighting.ExposureCompensation,
		}

		applyFullbright()

		brightToggle.Text = "FULLBRIGHT: ON"
		brightToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
	else
		if lightingBackup then
			for property, value in pairs(lightingBackup) do
				Lighting[property] = value
			end
		end

		for object, values in pairs(atmosphereBackup) do
			if object.Parent then
				object.Density = values.Density
				object.Haze = values.Haze
			end
		end

		atmosphereBackup = {}

		brightToggle.Text = "FULLBRIGHT: OFF"
		brightToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
	end
end

brightToggle.MouseButton1Click:Connect(function()
	setFullbright(not fullbright)
end)

-- game tự chỉnh lại lighting (ngày/đêm, hiệu ứng) thì ép sáng lại
task.spawn(function()
	while gui.Parent do
		if fullbright then
			pcall(applyFullbright)
		end

		task.wait(1)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	elseif input.KeyCode == Enum.KeyCode.G then
		setAutoAttack(not autoAttacking)
	elseif input.KeyCode == Enum.KeyCode.H then
		setAutoFarm(not autoFarm)
	elseif input.KeyCode == Enum.KeyCode.J then
		setFullbright(not fullbright)
	end
end)

player.CharacterAdded:Connect(function()
	aimTarget = nil
	farmDestination = nil
	farmAwayDir = nil
	farmTargetModel = nil

	if flying then
		stopFly()
	end

	-- hồi sinh xong thì farm tự bay lại
	if autoFarm then
		task.delay(1.5, function()
			if autoFarm and not flying then
				startFly()
			end
		end)
	end
end)

gui.Destroying:Connect(function()
	stopFly()

	-- trả lighting về gốc, khỏi để map sáng trắng sau khi tắt script
	if fullbright then
		setFullbright(false)
	end
end)
