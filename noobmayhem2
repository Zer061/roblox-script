-- ===== AUTO ATTACK =====

local autoAttacking = false
local attackRange = 60
local attackCooldown = 0.2

local blacklist = {} -- [model] = thời điểm hết hạn, cho mục tiêu không tiếp cận được

local function getTargetRoot(humanoid)
	if humanoid.Health <= 0 then
		return nil
	end

	local model = humanoid.Parent

	if not model or not model:IsA("Model") or model == player.Character then
		return nil
	end

	-- bỏ qua người chơi thật, chỉ đánh NPC/noob
	if Players:GetPlayerFromCharacter(model) then
		return nil
	end

	local expiry = blacklist[model]

	if expiry then
		if os.clock() < expiry then
			return nil
		end

		blacklist[model] = nil
	end

	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

-- Quét 1 lần, trả về danh sách mục tiêu hợp lệ trong tầm
local function collectTargets(root, maxDistance)
	local targets = {}

	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Humanoid") then
			local targetRoot = getTargetRoot(object)

			if targetRoot then
				local distance = (targetRoot.Position - root.Position).Magnitude

				if distance <= maxDistance then
					table.insert(targets, {
						root = targetRoot,
						model = object.Parent,
						name = object.Parent.Name,
						distance = distance,
					})
				end
			end
		end
	end

	return targets
end

local function getNearestTarget(root)
	local best

	for _, target in ipairs(collectTargets(root, attackRange)) do
		if not best or target.distance < best.distance then
			best = target
		end
	end

	if not best then
		return nil
	end

	return best.root, best.name, best.distance
end

local function getEquippedTool(character, humanoid)
	local tool = character:FindFirstChildOfClass("Tool")

	if tool then
		return tool
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	local stored = backpack and backpack:FindFirstChildOfClass("Tool")

	if not stored then
		return nil
	end

	humanoid:EquipTool(stored)

	if stored.Parent ~= character then
		stored.Parent = character
	end

	return character:FindFirstChildOfClass("Tool")
end

-- Súng thường nghe Mouse.Button1Down chứ không phải Tool.Activated,
-- nên phải giả lập click chuột thật vào đúng vị trí mục tiêu trên màn hình.
local GuiService = game:GetService("GuiService")
local virtualUser = nil

pcall(function()
	virtualUser = game:GetService("VirtualUser")
end)

local fireMethod = "?"
local aimCameraAtTarget = true -- đặt false nếu không muốn camera bị giật về mục tiêu

local function fireWeapon(tool, targetRoot)
	-- Tầng 1: cách chuẩn của Roblox
	local activated = pcall(function()
		tool:Activate()
	end)

	if activated then
		fireMethod = "Activate"
	end

	if not targetRoot then
		return
	end

	local camera = Workspace.CurrentCamera

	if not camera then
		return
	end

	-- kéo camera về mục tiêu, không thì Mouse.Hit của game trỏ đi chỗ khác
	if aimCameraAtTarget then
		pcall(function()
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetRoot.Position)
		end)
	end

	local point, onScreen = camera:WorldToViewportPoint(targetRoot.Position)

	if not onScreen then
		return -- mục tiêu ngoài màn hình thì click cũng vô nghĩa
	end

	local inset = GuiService:GetGuiInset()
	local screenPoint = Vector2.new(point.X, point.Y + inset.Y)

	-- Tầng 2: VirtualUser (executor nào cũng có)
	if virtualUser then
		local ok = pcall(function()
			virtualUser:Button1Down(screenPoint, camera.CFrame)
			virtualUser:Button1Up(screenPoint, camera.CFrame)
		end)

		if ok then
			fireMethod = "VirtualUser"
			return
		end
	end

	-- Tầng 3: hàm click gốc của executor
	local moveMouse, clickMouse

	pcall(function()
		local env = (getgenv and getgenv()) or getfenv()
		moveMouse = rawget(env, "mousemoveabs")
		clickMouse = rawget(env, "mouse1click")
	end)

	if type(clickMouse) == "function" then
		pcall(function()
			if type(moveMouse) == "function" then
				moveMouse(screenPoint.X, screenPoint.Y)
				task.wait()
			end

			clickMouse()
		end)

		fireMethod = "mouse1click"
	end
end

local function attackStep()
	if autoFarm or retreating then
		return -- Auto Farm tự lo phần đánh; đang rút lui thì không đánh nữa
	end

	local root, humanoid = getCharacterParts()

	if not root then
		aimTarget = nil
		statusLabel.Text = "Target: none"
		return
	end

	local targetRoot, targetName, distance = getNearestTarget(root)

	aimTarget = targetRoot

	if not targetRoot then
		statusLabel.Text = "Target: none"
		return
	end

	statusLabel.Text = string.format("Target: %s (%.0f)", targetName, distance)

	-- quay mặt về mục tiêu (khi bay thì BodyGyro lo phần này)
	if not flying then
		local look = (targetRoot.Position - root.Position) * Vector3.new(1, 0, 1)

		if look.Magnitude > 0.01 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit)
		end
	end

	local tool = getEquippedTool(player.Character, humanoid)

	if tool then
		fireWeapon(tool, targetRoot)
	end
end

