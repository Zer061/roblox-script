-- ===== AUTO ATTACK =====

local autoAttacking = false
local attackRange = 60
local attackCooldown = 0.2

local function getTargetRoot(humanoid)
	if humanoid.Health <= 0 then
		return nil
	end

	local model = humanoid.Parent

	if not model or not model:IsA("Model") or model == player.Character then
		return nil
	end

	-- bỏ qua người chơi thật, chỉ đánh NPC/noob
	if Players:GetPlayerFromCharacter(model) then
		return nil
	end

	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
end

local function getNearestTarget(root)
	local bestRoot, bestName, bestDistance = nil, nil, attackRange

	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("Humanoid") then
			local targetRoot = getTargetRoot(object)

			if targetRoot then
				local distance = (targetRoot.Position - root.Position).Magnitude

				if distance <= bestDistance then
					bestRoot, bestName, bestDistance = targetRoot, object.Parent.Name, distance
				end
			end
		end
	end

	return bestRoot, bestName, bestDistance
end

local function getEquippedTool(character, humanoid)
	local tool = character:FindFirstChildOfClass("Tool")

	if tool then
		return tool
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	local stored = backpack and backpack:FindFirstChildOfClass("Tool")

	if not stored then
		return nil
	end

	humanoid:EquipTool(stored)

	if stored.Parent ~= character then
		stored.Parent = character
	end

	return character:FindFirstChildOfClass("Tool")
end

local function attackStep()
	local root, humanoid = getCharacterParts()

	if not root then
		aimTarget = nil
		statusLabel.Text = "Target: none"
		return
	end

	local targetRoot, targetName, distance = getNearestTarget(root)

	aimTarget = targetRoot

	if not targetRoot then
		statusLabel.Text = "Target: none"
		return
	end

	statusLabel.Text = string.format("Target: %s (%.0f)", targetName, distance)

	-- quay mặt về mục tiêu (khi bay thì BodyGyro lo phần này)
	if not flying then
		local look = (targetRoot.Position - root.Position) * Vector3.new(1, 0, 1)

		if look.Magnitude > 0.01 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + look.Unit)
		end
	end

	local tool = getEquippedTool(player.Character, humanoid)

	if tool then
		tool:Activate()
	end
end

local function setAutoAttack(state)
	autoAttacking = state

	if autoAttacking then
		attackToggle.Text = "AUTO ATK: ON"
		attackToggle.BackgroundColor3 = Color3.fromRGB(45, 170, 75)
	else
		attackToggle.Text = "AUTO ATK: OFF"
		attackToggle.BackgroundColor3 = Color3.fromRGB(170, 45, 45)
		aimTarget = nil
		statusLabel.Text = "Target: none"
	end
end

attackToggle.MouseButton1Click:Connect(function()
	setAutoAttack(not autoAttacking)
end)

local function setRange(value)
	attackRange = math.clamp(value, 10, 500)
	rangeLabel.Text = "Range: " .. attackRange
end

rangeUp.MouseButton1Click:Connect(function()
	setRange(attackRange + 10)
end)

rangeDown.MouseButton1Click:Connect(function()
	setRange(attackRange - 10)
end)

task.spawn(function()
	while gui.Parent do
		if autoAttacking then
			local ok, err = pcall(attackStep)

			if not ok then
				warn("[AutoAttack]", err)
			end
		end

		task.wait(attackCooldown)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.F then
		toggleFly()
	elseif input.KeyCode == Enum.KeyCode.G then
		setAutoAttack(not autoAttacking)
	end
end)

player.CharacterAdded:Connect(function()
	aimTarget = nil

	if flying then
		stopFly()
	end
end)

gui.Destroying:Connect(stopFly)
